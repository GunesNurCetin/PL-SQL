-- 1. SCHEMA SETUP (Tablo Yapılandırması)
-- -----------------------------------------------------------------------------
BEGIN
    EXECUTE IMMEDIATE 'DROP TABLE loan_history';
    EXECUTE IMMEDIATE 'DROP TABLE books';
EXCEPTION WHEN OTHERS THEN NULL; END;
/

CREATE TABLE books (
    book_id NUMBER PRIMARY KEY,
    title VARCHAR2(150),
    author VARCHAR2(100),
    is_available CHAR(1) CHECK (is_available IN ('Y', 'N'))
);

CREATE TABLE loan_history (
    loan_id NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    book_id NUMBER REFERENCES books(book_id),
    borrower_name VARCHAR2(100),
    loan_date DATE DEFAULT SYSDATE,
    return_date DATE, -- Eğer boşsa kitap hala kullanıcıdadır
    penalty_amount NUMBER(10, 2) DEFAULT 0
);

-- 2. DUMMY DATA (Örnek Kitaplar)
INSERT INTO books VALUES (1, 'Nutuk', 'Mustafa Kemal Atatürk', 'Y');
INSERT INTO books VALUES (2, 'İnce Memed', 'Yaşar Kemal', 'Y');
INSERT INTO books VALUES (3, '1984', 'George Orwell', 'Y');
COMMIT;

-- 3. PENALTY CALCULATION FUNCTION (Ceza Hesaplama Fonksiyonu)
-- -----------------------------------------------------------------------------
-- Kitabın teslim edilmesi gereken tarihten (15 gün) sonrasını hesaplar.
CREATE OR REPLACE FUNCTION fn_calculate_penalty(
    p_loan_date IN DATE,
    p_return_date IN DATE DEFAULT SYSDATE
) RETURN NUMBER IS
    v_days_diff NUMBER;
    v_penalty_rate NUMBER := 2.50; -- Günlük gecikme bedeli (TL)
BEGIN
    v_days_diff := FLOOR(p_return_date - p_loan_date);
    
    -- Eğer 15 günü geçtiyse ceza hesapla
    IF v_days_diff > 15 THEN
        RETURN (v_days_diff - 15) * v_penalty_rate;
    ELSE
        RETURN 0;
    END IF;
END fn_calculate_penalty;
/

-- 4. LIBRARY MANAGEMENT PACKAGE (Kütüphane Paketi)
-- -----------------------------------------------------------------------------
CREATE OR REPLACE PACKAGE pkg_library_ops AS
    -- Kitap ödünç al
    PROCEDURE borrow_book(p_book_id NUMBER, p_borrower VARCHAR2);
    
    -- Kitap iade et
    PROCEDURE return_book(p_book_id NUMBER);
END pkg_library_ops;
/

CREATE OR REPLACE PACKAGE BODY pkg_library_ops AS
    PROCEDURE borrow_book(p_book_id NUMBER, p_borrower VARCHAR2) IS
        v_status CHAR(1);
    BEGIN
        SELECT is_available INTO v_status FROM books WHERE book_id = p_book_id;
        
        IF v_status = 'Y' THEN
            INSERT INTO loan_history (book_id, borrower_name, loan_date)
            VALUES (p_book_id, p_borrower, SYSDATE);
            
            UPDATE books SET is_available = 'N' WHERE book_id = p_book_id;
            COMMIT;
            DBMS_OUTPUT.PUT_LINE(p_book_id || ' ID''li kitap ödünç verildi.');
        ELSE
            DBMS_OUTPUT.PUT_LINE('Hata: Kitap şu an mevcut değil.');
        END IF;
    END borrow_book;

    PROCEDURE return_book(p_book_id NUMBER) IS
        v_loan_id NUMBER;
        v_loan_date DATE;
        v_penalty NUMBER;
    BEGIN
        -- Son ödünç alma kaydını bul
        SELECT loan_id, loan_date INTO v_loan_id, v_loan_date
        FROM loan_history
        WHERE book_id = p_book_id AND return_date IS NULL;

        -- Fonksiyonu kullanarak cezayı hesapla
        v_penalty := fn_calculate_penalty(v_loan_date, SYSDATE);

        -- Kaydı güncelle
        UPDATE loan_history 
        SET return_date = SYSDATE, penalty_amount = v_penalty
        WHERE loan_id = v_loan_id;

        UPDATE books SET is_available = 'Y' WHERE book_id = p_book_id;
        
        COMMIT;
        DBMS_OUTPUT.PUT_LINE('Kitap iade alindi. Hesaplanan Ceza: ' || v_penalty || ' TL');
    END return_book;
END pkg_library_ops;
/

-- 5. TEST SENARYOSU
-- -----------------------------------------------------------------------------
SET SERVEROUTPUT ON;
BEGIN
    -- Senaryo 1: Kitap Ödünç Al
    pkg_library_ops.borrow_book(1, 'Ali Can');
    
    -- Senaryo 2: Geçmişe dönük bir kayıt ekleyelim (Ceza testi için)
    INSERT INTO loan_history (book_id, borrower_name, loan_date)
    VALUES (2, 'Veli Bak', SYSDATE - 20); -- 20 gün önce alınmış (5 gün gecikme)
    UPDATE books SET is_available = 'N' WHERE book_id = 2;
    COMMIT;

    -- Senaryo 3: Geciken kitabı iade et
    pkg_library_ops.return_book(2);
END;
/

