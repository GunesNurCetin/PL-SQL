/*******************************************************************************
  PROJE ADI: HR Analytics & Dynamic Bonus Engine
  YAZAR: [Güneş Nur ÇETİN/@GunesNurCetin]
  TARİH: 2026-04-08
  
  AÇIKLAMA (TR): 
  Bu sistem, çalışanların performans puanlarına ve departman hedeflerine göre 
  aylık toplam kazançlarını hesaplar. Toplu veri işleme ve karmaşık 
  mantıksal hesaplamalar üzerine odaklanır.
  
  FEATURES (EN):
  - Dynamic Bonus Logic: Calculate salary + bonus based on performance scores.
  - Record & Rowtype Usage: Efficient row-level data manipulation.
  - Automated Payroll Logging: Storing monthly financial outcomes.
*******************************************************************************/

-- 1. SCHEMA SETUP (Tablo Yapılandırması)
-- -----------------------------------------------------------------------------
BEGIN
    EXECUTE IMMEDIATE 'DROP TABLE payroll_history';
    EXECUTE IMMEDIATE 'DROP TABLE employees';
EXCEPTION WHEN OTHERS THEN NULL; END;
/

CREATE TABLE employees (
    emp_id NUMBER PRIMARY KEY,
    first_name VARCHAR2(50),
    last_name VARCHAR2(50),
    base_salary NUMBER(15, 2),
    perf_score NUMBER(3,1) CHECK (perf_score BETWEEN 0 AND 5), -- 0 ile 5 arası puan
    department VARCHAR2(50)
);

CREATE TABLE payroll_history (
    payroll_id NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    emp_id NUMBER REFERENCES employees(emp_id),
    total_payment NUMBER(15, 2),
    payment_date DATE DEFAULT SYSDATE,
    calculation_note VARCHAR2(255)
);

-- 2. DUMMY DATA (Örnek Çalışanlar)
INSERT INTO employees VALUES (1, 'Can', 'Öztürk', 45000, 4.8, 'IT');
INSERT INTO employees VALUES (2, 'Deniz', 'Aras', 38000, 3.2, 'Sales');
INSERT INTO employees VALUES (3, 'Ebru', 'Yılmaz', 41000, 4.5, 'IT');
COMMIT;

-- 3. PAYROLL MANAGEMENT PACKAGE (Maaş ve Performans Paketi)
-- -----------------------------------------------------------------------------
CREATE OR REPLACE PACKAGE pkg_hr_analytics AS
    -- Maaş ve prim hesaplayan ana prosedür
    PROCEDURE run_monthly_payroll;
    
    -- Belirli bir çalışanın performansını güncelle
    PROCEDURE update_performance(p_emp_id NUMBER, p_new_score NUMBER);
END pkg_hr_analytics;
/

CREATE OR REPLACE PACKAGE BODY pkg_hr_analytics AS
    PROCEDURE run_monthly_payroll IS
        -- %ROWTYPE kullanarak tüm tablo yapısını tek bir değişkene alıyoruz
        v_emp_record employees%ROWTYPE;
        v_bonus_amount NUMBER(15, 2);
        v_final_amount NUMBER(15, 2);
        
        CURSOR c_emps IS SELECT * FROM employees;
    BEGIN
        DBMS_OUTPUT.PUT_LINE('--- AYLIK MAAS VE PRIM HESAPLAMA BASLADI ---');
        
        FOR r_emp IN c_emps LOOP
            -- Prim Mantığı: Skor 4 üzeriyse %20, 3 üzeriyse %10 bonus
            IF r_emp.perf_score >= 4.0 THEN
                v_bonus_amount := r_emp.base_salary * 0.20;
            ELSIF r_emp.perf_score >= 3.0 THEN
                v_bonus_amount := r_emp.base_salary * 0.10;
            ELSE
                v_bonus_amount := 0;
            END IF;

            v_final_amount := r_emp.base_salary + v_bonus_amount;

            -- Bordro tablosuna kayıt at
            INSERT INTO payroll_history (emp_id, total_payment, calculation_note)
            VALUES (r_emp.emp_id, v_final_amount, 
                    'Base: ' || r_emp.base_salary || ' + Bonus: ' || v_bonus_amount);
            
            DBMS_OUTPUT.PUT_LINE('Calisan: ' || r_emp.first_name || ' ' || r_emp.last_name || 
                                 ' | Toplam: ' || v_final_amount);
        END LOOP;
        
        COMMIT;
    END run_monthly_payroll;

    PROCEDURE update_performance(p_emp_id NUMBER, p_new_score NUMBER) IS
    BEGIN
        UPDATE employees SET perf_score = p_new_score WHERE emp_id = p_emp_id;
        COMMIT;
        DBMS_OUTPUT.PUT_LINE(p_emp_id || ' ID''li calisanin skoru güncellendi.');
    END update_performance;
END pkg_hr_analytics;
/

-- 4. TEST SENARYOSU
-- -----------------------------------------------------------------------------
SET SERVEROUTPUT ON;
BEGIN
    -- 1. Bir çalışanın performansını yükselt
    pkg_hr_analytics.update_performance(2, 4.2);
    
    -- 2. Tüm şirketin maaşlarını hesapla
    pkg_hr_analytics.run_monthly_payroll;
END;
/

-- Sonuçları raporla
SELECT e.first_name, e.last_name, p.total_payment, p.calculation_note 
FROM employees e 
JOIN payroll_history p ON e.emp_id = p.emp_id;
